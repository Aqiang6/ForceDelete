@echo off
chcp 936 >nul 2>&1
title 强制删除工具

:: 检查是否有拖入文件/文件夹
if "%~1"=="" (
    echo [错误] 请将文件或文件夹拖放到本脚本上运行！
    pause
    exit /b 1
)

:: 遍历所有拖入的项目（支持多选拖入）
:loop
if "%~1"=="" goto :done

echo ============================================
echo  目标: %~1
echo ============================================

:: 判断是文件还是文件夹
if exist "%~1\" (
    echo [类型] 文件夹 - 正在强制删除...
    rd /s /q "%~1" 2>nul
) else if exist "%~1" (
    echo [类型] 文件 - 正在强制删除...
    del /f /q /a "%~1" 2>nul
) else (
    echo [跳过] 路径不存在: %~1
)

:: 验证删除结果
if exist "%~1" (
    echo [失败] 删除未成功，可能被占用或权限不足
) else (
    echo [成功] 已彻底删除
)
echo.

shift
goto :loop

:done
echo ============================================
echo  全部处理完毕
echo ============================================
pause